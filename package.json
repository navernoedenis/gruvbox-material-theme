{
  "name": "gruvbox-material-theme",
  "displayName": "Gruvbox Theme (Material)",
  "version": "1.4.0",
  "description": "Gruvbox-style theme for VS Code",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "customization",
    "gruvbox",
    "material",
    "theme",
    "themes"
  ],
  "homepage": "https://github.com/navernoedenis/gruvbox-material-theme",
  "bugs": {
    "url": "https://github.com/navernoedenis/gruvbox-material-theme/issues"
  },
  "license": "MIT",
  "author": {
    "name": "navernoedenis",
    "email": "navernoedenis@gmail.com",
    "url": "https://github.com/navernoedenis"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navernoedenis/gruvbox-material-theme.git"
  },
  "publisher": "navernoedenis",
  "main": "dist/app.entry.js",
  "scripts": {
    "build:app": "bun compile && bun package",
    "build:logo": "bun ./src/scripts/build-logo.ts",
    "build:theme": "bun ./src/scripts/build-theme.ts && mv ./src/gruvbox-*.json ./dist",
    "compile:clean": "rimraf dist && rimraf *.vsix",
    "compile": "bun compile:clean && tsc && bun build:theme",
    "format": "oxfmt",
    "lint:fix": "oxlint --fix",
    "lint": "oxlint",
    "package": "bun build:logo && bun vsce package",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "^4.0.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run format && bun run lint"
  },
  "contributes": {
    "themes": [
      {
        "id": "gruvbox-material-theme",
        "label": "Gruvbox Theme (Material)",
        "uiTheme": "vs-dark",
        "path": "./dist/gruvbox-material-theme.json"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Gruvbox Theme (Material)",
      "properties": {
        "gruvbox-material-theme.editor.contrast": {
          "description": "Set the background contrast for the theme.",
          "type": "string",
          "enum": [
            "soft",
            "medium",
            "hard",
            "slate"
          ],
          "enumDescriptions": [
            "Light background for easy-on-the-eyes coding",
            "Balanced light/dark background for general use",
            "Dark background for maximum contrast and focus",
            "A cool-toned gruvbox theme inspired by matcha-dark-sea"
          ],
          "default": "medium"
        },
        "gruvbox-material-theme.editor.cursor": {
          "description": "Pick the color of your text cursor.",
          "type": "string",
          "enum": [
            "aqua",
            "blue",
            "green",
            "orange",
            "purple",
            "red",
            "white",
            "yellow"
          ],
          "default": "white"
        },
        "gruvbox-material-theme.editor.palette": {
          "description": "Choose the main color palette for your editor.",
          "type": "string",
          "enum": [
            "classic",
            "material",
            "pastel"
          ],
          "enumDescriptions": [
            "Classic gruvbox colors for a traditional look",
            "Material-inspired gruvbox colors for a modern feel",
            "A brighter color palette with muted pastel accents"
          ],
          "default": "material"
        },
        "gruvbox-material-theme.editor.selection": {
          "description": "Customize the background color of selected text.",
          "type": "string",
          "enum": [
            "aqua",
            "blue",
            "green",
            "grey",
            "orange",
            "purple",
            "red",
            "yellow"
          ],
          "default": "grey"
        },
        "gruvbox-material-theme.editor.separators": {
          "description": "Add separators for clearer section separation.",
          "type": "boolean",
          "default": false
        },
        "gruvbox-material-theme.editor.sidebar-bright-text": {
          "description": "Add bright color to sidebar text.",
          "type": "boolean",
          "default": false
        },
        "gruvbox-material-theme.tokens.env-color": {
          "description": "Change color of .env variables.",
          "type": "string",
          "enum": [
            "blue",
            "orange",
            "red",
            "yellow"
          ],
          "default": "orange"
        }
      }
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#292828",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  }
}
